{
  "name": "merchanthaus",
  "version": "1.0.0",
  "private": true,
  "description": "MerchantHaus - Merchant Services",
  "scripts": {
    "dev": "netlify dev",
    "start": "netlify dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
       "build": "rm -rf dist && mkdir -p dist/integrations dist/blogs && cp -a *.html dist/ && cp -a integrations/*.html dist/integrations/ && cp -a src/pages/blogs/*.html dist/blogs/ && cp -a assets dist/ && cp -a public dist/ && cp -a favicons dist/ && cp favicon.ico robots.txt sitemap.xml site.webmanifest dist/"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.545.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "jest": "^29.7.0",
    "netlify-cli": "^23.8.1",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  }
}
